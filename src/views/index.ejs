<%- include('partials/header') %>

<main class="container py-5">
    <h1 class="mb-4" id="events-title">События</h1>

    <div class="row">
        <!-- ЛЕВАЯ КОЛОНКА: фильтры -->
        <aside class="col-lg-3 col-md-4 mb-4">
            <h5>Категория</h5>

            <% menu.forEach(tag => { %>
                <div class="form-check">
                    <input
                        class="form-check-input filter-checkbox"
                        type="checkbox"
                        value="<%= tag._id %>"
                    >
                    <label class="form-check-label"><%= tag.name %></label>
                </div>
            <% }) %>

            <div class="mt-4" id="calendar"></div>
        </aside>

        <!-- ПРАВАЯ КОЛОНКА: события -->
        <section class="col-lg-9 col-md-8">
            <div class="row g-4" id="events">
                <% if (!events || events.length === 0) { %>
                    <p class="text-muted">Событий нет</p>
                <% } %>

                <% events.forEach(event => { %>
                    <div class="col-md-4 event-item"
                         data-tag="<%= event.tag %>"
                         data-date="<%= event.date || '' %>">

                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <% if (event.image) { %>
                                    <img src="<%= event.image %>" alt="<%= event.title %>" class="img-fluid mb-3">
                                <% } %>

                                <span class="badge bg-dark mb-2"><%= event.tag %></span>

                                <h5 class="card-title"><%= event.title %></h5>
                                <p>📍 <%= event.location %></p>
                                <p>📅 <%= event.date || '' %></p>

                                <a href="/event/<%= event._id %>" class="btn btn-primary btn-sm">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>
    </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const checkboxes = document.querySelectorAll('.filter-checkbox');
    const events = document.querySelectorAll('.event-item');
    const title = document.getElementById('events-title');
    let selectedDate = null;

    function filterEvents() {
        const selectedTags = Array.from(checkboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value);

        let visibleCount = 0;

        events.forEach(ev => {
            const evTag = ev.dataset.tag;
            const evDate = ev.dataset.date;

            const tagMatch = selectedTags.length === 0 || selectedTags.includes(evTag);
            const dateMatch = !selectedDate || evDate === selectedDate;

            if (tagMatch && dateMatch) {
                ev.style.display = '';
                visibleCount++;
            } else {
                ev.style.display = 'none';
            }
        });

        title.textContent = selectedDate
            ? `События на ${selectedDate}`
            : 'События';

        if (visibleCount === 0) title.textContent += ' — событий нет';
    }

    // Фильтр по чекбоксам
    checkboxes.forEach(cb => cb.addEventListener('change', filterEvents));

    // Календарь VanillaCalendar
    const calendar = new VanillaCalendar('#calendar', {
        settings: { lang: 'ru', selection: { day: 'single' } },
        actions: {
            clickDay(e) {
                selectedDate = e.target.dataset.calendarDay;
                filterEvents();
            }
        }
    });
    calendar.init();
});
</script>

<%- include('partials/footer') %>
